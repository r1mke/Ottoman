# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# SQL Server SA password (min 8 chars, upper+lower+digit+symbol)
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

RABBITMQ_USER=ottoman
RABBITMQ_PASSWORD=ChangeMe_Rabbit1

# Environment. docker-compose defaults to Production (and no demo data) when this is not set.
# Development = local demo: demo accounts, Scalar API docs, StartupGuards relaxed. Never on a server.
ASPNETCORE_ENVIRONMENT=Development

# Seeding. DEMO data must be false in any real deployment.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Test123!
SEED_ADMIN_EMAIL=admin@ottoman.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin1!

# Ports (optional)
# API_PORT=5080
# SQL_PORT=14330

# SMTP (default: local Mailpit inbox on http://localhost:8025)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# With SMTP_USER/SMTP_PASSWORD set, TLS is required: STARTTLS, or TLS on connect for port 465.
# SMTP_SECURITY=StartTls   # optional override: StartTls | SslOnConnect

# JWT signing key (min 32 chars). Generate: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-change-me-change-me-change-me-1234

# Stripe (optional). Empty = card orders are created but can never be paid (fake gateway).
# Webhook endpoint to register in Stripe: POST {API}/api/v1/payments/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (optional). Empty = uploads are validated but not stored anywhere.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Firebase push (optional). The whole service account key as one line of JSON, in single quotes.
# Empty = pushes are recorded in memory only.
# FIREBASE_SERVICE_ACCOUNT_JSON='{...}'

# Encrypts the stored data-protection keys (required in production, and the SAME value for api and worker).
# Generate once: openssl rand -base64 32
# DP_KEY_ENCRYPTION_SECRET=

# Browser origin allowed to call the API (optional; the apps are native and need none). Exact https origin only.
# CORS_ORIGIN=https://admin.example.com
